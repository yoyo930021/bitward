<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- SMAppService agent 的沙盒化 daemon 容器（BitwardDaemon.app）專用 entitlements。
	     存在理由（2026-11-08 實測鏈）：沙盒 App 送件時 smd 要求目標執行檔也沙盒化
	     （「target executable must be sandboxed」→ 否則 EPERM）；但**裸二進位**加
	     app-sandbox 會死在 dyld secinit（SIGTRAP，terminal／launchd 皆然）——
	     沙盒需要自己的 bundle 身分，故 daemon 以嵌套 App 形態落地，
	     容器＝~/Library/Containers/io.bitward.dev.daemon。 -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.8V5224A99M.io.bitward.dev</string>
	</array>
	<!-- daemon 連 Vaultwarden（https 出站）與 ntfy 推送 -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- legacy／CLI 相容的 tmp sock 落點（沙盒內寫 /private/tmp 需絕對路徑例外） -->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
	<array>
		<string>/private/tmp/io.bitward.dev/</string>
	</array>
</dict>
</plist>
