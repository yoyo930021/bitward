<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- SMAppService.agent(plistName:) 正確形態：歸因給 App（__CFBundleIdentifier）
	     + BundleProgram（bundle 相對路徑）。ProgramArguments[0] 為 argv[0] 佔位，
	     實際執行檔由 BundleProgram 決定。歸因後 launchd 以 App 的 group 成員
	     身分跑 daemon → 可 bind group container socket。 -->
	<key>Label</key>
	<string>io.bitward.dev.daemon</string>
	<key>__CFBundleIdentifier</key>
	<string>io.bitward.dev</string>
	<key>BundleProgram</key>
	<string>Contents/Helpers/BitwardDaemon.app/Contents/MacOS/bitwarderd</string>
	<key>ProgramArguments</key>
	<array>
		<string>bitwarderd</string>
		<string>--sock</string>
		<string>/private/tmp/io.bitward.dev/daemon.sock</string>
		<string>--push-app-group</string>
		<string>group.8V5224A99M.io.bitward.dev</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>1</integer>
	<!-- 沙盒 App 經 SMAppService 送件時，smd 政策明令禁止 Standard{In,Out,Error}Path
	     （log 實拍「Not allowed to use StandardInPath, StandardOutPath, and StandardErrorPath
	     keys from AppSandboxed submitters」→ register EINVAL）。daemon 日誌走 os_log。 -->
</dict>
</plist>
