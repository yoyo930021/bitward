<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- autofill-credential-provider 必須同時掛在容器 App 與 extension（macos-provider.md §1） -->
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- APNs（§1.2 推播）：本機 Mac Developer 簽章無 portal capability 時
	     registerForRemoteNotifications 走 didFail 日誌路徑（預期）；
	     Developer ID＋App ID 開 push 後即刻生效，不需再改 entitlements。 -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.8V5224A99M.io.bitward.dev</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>8V5224A99M.io.bitward.dev</string>
	</array>
</dict>
</plist>
