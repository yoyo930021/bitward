<!-- AndroidManifest 片段（尚未併入 APK；見本目錄 README.md）。
     nsh 0.3.0 的 `nsh package --target android` 只放 prebuilt runtime 的
     classes.dex + lib/<ABI>/libnsh.so，沒有 app 自己的 Kotlin 來源或
     manifest 掛鉤，所以這片是下一批 Gradle 外殼要 merge 的內容。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.bitward.android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <!-- 填充服務：契約 §1「Android app＝Full（in-process 中樞）」；
             中樞跑在這個程序裡（foreground service 保命），
             AutofillService 與之同程序，直接走程序內介面，不經 BTP。 -->
        <service
            android:name=".BitwardAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>

        <!-- API 34 CredentialProviderService（passkeys + passwords） -->
        <service
            android:name=".BitwardCredentialProviderService"
            android:exported="true"
            android:directBootAware="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.service.credentials"
                android:resource="@xml/credential_provider" />
        </service>

        <!-- in-process 中樞的保命服務（契約 §1：foreground service） -->
        <service
            android:name=".HubService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
