<?xml version="1.0" encoding="utf-8"?>
<!-- 外殼 manifest：application/activity 節复刻 nsh 0.3.0 產的 APK
     （apkanalyzer 讀出：theme=Theme.Material.Light.NoActionBar、minSdk 28、
     targetSdk 35、configChanges 0x40003ff4、windowSoftInputMode 0x10=adjustResize），
     再加三個孤島 service（原 android/src/main/AndroidManifest.snippet.xml）。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".BitwardApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:supportsRtl="true"
        android:extractNativeLibs="false"
        android:enableOnBackInvokedCallback="true">

        <!-- nsh runtime 認這個標記才走純 Rust 根元件 -->
        <meta-data
            android:name="com.longbridge.nsh.RUST"
            android:value="true" />

        <activity
            android:name="com.longbridge.nsh.AppActivity"
            android:exported="true"
            android:configChanges="locale|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- e2e A16 專用填充探針頁：hint 帳密欄＋commit 鈕（驗 save 全鏈，
             正式入口不列 launcher）。 -->
        <activity
            android:name=".AutofillProbeActivity"
            android:exported="true"
            android:label="Autofill 探針"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- 生物辨識彈窗宿主（第五批：Keystore 解封/封存的驗證斷言面）：
             透明、無歷史、不進最近任務。 -->
        <activity
            android:name=".BiometricPromptActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 33+ 通知權限補要（HubService 首起時拉，問完即收）。 -->
        <activity
            android:name=".PermissionRequestActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 填充服務：契約 §1「Android app＝Full（in-process 中樞）」；
             中樞與本服務同程序（不宣告 android:process），走程序內介面，不經 BTP。 -->
        <service
            android:name=".BitwardAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>

        <!-- API 34 CredentialProviderService（passkeys + passwords）。
             SERVICE_META_DATA（android.credentials.provider）要等 passkey 面
             （P4b 第二批）才宣告，綁定本身不需要。 -->
        <service
            android:name=".BitwardCredentialProviderService"
            android:exported="true"
            android:directBootAware="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
        </service>

        <!-- in-process 中樞的保命服務（契約 §1：foreground service）＋背景同步
             載具（第五批：JobService 形態，JobScheduler 15 分鐘週期）。 -->
        <service
            android:name=".HubService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
